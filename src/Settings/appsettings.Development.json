{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DbConnections": {
    "Postgres": {
      "ConnectionString": "User ID=postgres;Password=postgres;Host=localhost;Port=55432;Database=notifications;Pooling=true;Include Error Detail=true",
      "MaxRetry": 6,
      "MaxDelaySec": 30
    }
  },
  "Email": {
    "FromAddress": "email-address@yandex.ru",
    "SmtpServer": "smtp.yandex.com",
    "Port": 465,
    "Username": "email-username",
    "Password": "email-api-key",
    "EnableSsl": true,
    "TemplatesPath": "../templates"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "ConsumerTopics": {
      "EmailConfirmation": "EmailConfirmation"
    },
    "ConsumerGroupId": "svc-notifications"
  }
}